# Copy to .env and fill in. .env is NOT committed.
#
# Two namespaces live in this file:
#   FLOXFLIX_*       read by the bot
#   TELEGRAM_API_*   read by the local Bot API server container (docker-compose)

# --- Bot (required) ---

# Bot token from BotFather.
FLOXFLIX_BOT_TOKEN=

# Authorized numeric Telegram IDs, comma separated. Required: with an empty
# list the bot refuses to start.
FLOXFLIX_ALLOWED_USER_IDS=

# Local Bot API endpoints. Both must contain two %s: token and path.
FLOXFLIX_TELEGRAM_API_ENDPOINT=http://localhost:8081/bot%s/%s
FLOXFLIX_TELEGRAM_FILE_ENDPOINT=http://localhost:8081/file/bot%s/%s

# FloxFlix API. The genre list comes from there and every saved file is
# registered there (POST /v1/api/bot/videos). Empty = files are saved but
# nothing is published.
FLOXFLIX_API_URL=

# --- Local Bot API server (docker-compose) ---

# Telegram app credentials from https://my.telegram.org.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# --- Optional (defaults shown) ---

# Final folder where the files are stored.
# FLOXFLIX_DOWNLOAD_DIR=./uploads

# The local server's volume: path on the host and path inside the container.
# FLOXFLIX_TELEGRAM_DATA_DIR=./telegram-data
# FLOXFLIX_TELEGRAM_SERVER_WORK_DIR=/var/lib/telegram-bot-api

# Logs every Bot API request/response (careful: it prints the token).
# FLOXFLIX_DEBUG=false
